{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc ./src/server/index.ts --outDir ./dist --module preserve && next build",
    "check-format": "prettier --check .",
    "check-lint": "eslint src",
    "check-type": "tsc --noemit",
    "lint": "npm run check-lint && npm run check-type && npm run check-format",
    "start": "npx tsx --max-old-space-size=4096 src/server/index.ts",
    "prod": "cross-env NODE_ENV=production node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx ./src/lib/database/seed.ts",
    "postinstall": "node ./scripts/color-writer.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.2.2",
    "@imagekit/next": "^2.1.5",
    "@libsql/client": "^0.17.2",
    "@types/pg": "^8.20.0",
    "bcrypt": "^6.0.0",
    "classnames": "^2.5.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.8.0",
    "next": "^16.2.3",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.7",
    "pg": "^8.20.0",
    "postcss": "^8.5.9",
    "qs": "^6.15.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "react-hot-toast": "^2.6.0",
    "react-phone-input-2": "^2.15.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^6.0.1",
    "styled-components": "^6.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25",
    "@types/nodemailer": "^8.0.0",
    "@types/qs": "^6.15.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/styled-components": "^5.1.36",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.0",
    "eslint-config-next": "16.2.3",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6",
    "typescript-eslint": "^8.58.2"
  },
  "type": "module"
}
